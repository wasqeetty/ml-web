rules_version = '2';
// สายเรียน (SaiRian) — กฎความปลอดภัยของฐานข้อมูล
// 1) ใครล็อกอินแล้วอ่าน/เขียนได้เฉพาะข้อมูลของตัวเองที่ users/<uid> เท่านั้น
// 2) จำกัดขนาด/รูปแบบข้อมูล กันคนเขียนสคริปต์ยัดข้อมูลขยะจนโควตาฟรีเต็ม
service cloud.firestore {
  match /databases/{database}/documents {

    function isMe(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // ฟิลด์ข้อความ f ถ้ามี ต้องเป็นข้อความยาวไม่เกิน n ตัวอักษร
    function shortText(d, f, n) {
      return !(f in d) || (d[f] is string && d[f].size() <= n);
    }
    // ข้อมูลทั่วไป (บันทึก งาน คาบเรียน วิชา การตั้งค่า)
    function okItem(d) {
      return d.keys().size() <= 20
        && shortText(d, 'riverImg', 60000)
        && shortText(d, 'note', 2000)
        && shortText(d, 'title', 200)
        && shortText(d, 'topicTitle', 200)
        && shortText(d, 'name', 60)
        && shortText(d, 'subjectId', 100)
        && shortText(d, 'fish', 30);
    }
    // โปรไฟล์ที่กรอกตอนสมัคร
    function okProfile(p) {
      return p is map
        && p.keys().hasOnly(['realName', 'nickname', 'age', 'favSubject', 'interests', 'photoURL', 'createdAt', 'updatedAt',
                             'bio', 'cover', 'accent', 'shared', 'river'])
        && p.realName is string && p.realName.size() <= 80
        && p.nickname is string && p.nickname.size() <= 40
        && p.age is int && p.age >= 5 && p.age <= 100
        && p.favSubject is string && p.favSubject.size() <= 40
        && p.interests is list && p.interests.size() <= 20
        && shortText(p, 'photoURL', 500)
        && shortText(p, 'bio', 160)
        && shortText(p, 'cover', 20)
        && shortText(p, 'accent', 20)
        && (!('river' in p) || (p.river is map && p.river.keys().hasOnly(['season', 'fish'])
            && shortText(p.river, 'season', 20) && p.river.fish is list && p.river.fish.size() <= 8));
    }

    // 3) การ์ดโปรไฟล์ที่เจ้าของเปิดแชร์: คนที่ล็อกอินแล้วอ่านได้ เขียนได้เฉพาะเจ้าของ
    //    (ไม่มีชื่อจริง อายุ อีเมล หรือบันทึกที่จดไว้ อยู่ในนี้)
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['nickname', 'photoURL', 'bio', 'cover', 'accent', 'favSubject', 'interests', 'stats', 'river', 'updatedAt'])
        && request.resource.data.nickname is string && request.resource.data.nickname.size() <= 40
        && shortText(request.resource.data, 'photoURL', 500)
        && shortText(request.resource.data, 'bio', 160)
        && shortText(request.resource.data, 'cover', 20)
        && shortText(request.resource.data, 'accent', 20)
        && shortText(request.resource.data, 'favSubject', 40)
        && request.resource.data.interests is list && request.resource.data.interests.size() <= 20
        && request.resource.data.stats is map;
    }

    match /users/{uid} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['profile'])
        && okProfile(request.resource.data.profile);

      match /{col}/{docId} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid)
          && col in ['sessions', 'tasks', 'slots', 'subjects', 'settings']
          && okItem(request.resource.data);
      }
    }
  }
}
