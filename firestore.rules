rules_version = '2';
// สายเรียน (SaiRian) — กฎความปลอดภัยของฐานข้อมูล
// 1) ใครล็อกอินแล้วอ่าน/เขียนได้เฉพาะข้อมูลของตัวเองที่ users/<uid> เท่านั้น
// 2) จำกัดขนาด/รูปแบบข้อมูล กันคนเขียนสคริปต์ยัดข้อมูลขยะจนโควตาฟรีเต็ม
service cloud.firestore {
  match /databases/{database}/documents {

    function isMe(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // ฟิลด์ข้อความ f ถ้ามี ต้องเป็นข้อความยาวไม่เกิน n ตัวอักษร
    function shortText(d, f, n) {
      return !(f in d) || (d[f] is string && d[f].size() <= n);
    }
    // ข้อมูลทั่วไป (บันทึก งาน คาบเรียน วิชา การตั้งค่า)
    function okItem(d) {
      return d.keys().size() <= 20
        && shortText(d, 'riverImg', 60000)
        && shortText(d, 'note', 2000)
        && shortText(d, 'title', 200)
        && shortText(d, 'topicTitle', 200)
        && shortText(d, 'name', 60)
        && shortText(d, 'subjectId', 100)
        && shortText(d, 'fish', 30);
    }
    // โปรไฟล์ที่กรอกตอนสมัคร
    function okProfile(p) {
      return p is map
        && p.keys().hasOnly(['realName', 'nickname', 'age', 'favSubject', 'interests', 'photoURL', 'createdAt', 'updatedAt',
                             'bio', 'cover', 'accent', 'shared', 'river'])
        && p.realName is string && p.realName.size() <= 80
        && p.nickname is string && p.nickname.size() <= 40
        && p.age is int && p.age >= 5 && p.age <= 100
        && p.favSubject is string && p.favSubject.size() <= 40
        && p.interests is list && p.interests.size() <= 20
        && shortText(p, 'photoURL', 500)
        && shortText(p, 'bio', 160)
        && shortText(p, 'cover', 20)
        && shortText(p, 'accent', 20)
        && (!('river' in p) || (p.river is map && p.river.keys().hasOnly(['season', 'fish'])
            && shortText(p.river, 'season', 20) && p.river.fish is list && p.river.fish.size() <= 8));
    }

    // 3) การ์ดโปรไฟล์ที่เจ้าของเปิดแชร์: คนที่ล็อกอินแล้วอ่านได้ เขียนได้เฉพาะเจ้าของ
    //    (ไม่มีชื่อจริง อายุ อีเมล หรือบันทึกที่จดไว้ อยู่ในนี้)
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['nickname', 'photoURL', 'bio', 'cover', 'accent', 'favSubject', 'interests', 'stats', 'river', 'updatedAt'])
        && request.resource.data.nickname is string && request.resource.data.nickname.size() <= 40
        && shortText(request.resource.data, 'photoURL', 500)
        && shortText(request.resource.data, 'bio', 160)
        && shortText(request.resource.data, 'cover', 20)
        && shortText(request.resource.data, 'accent', 20)
        && shortText(request.resource.data, 'favSubject', 40)
        && request.resource.data.interests is list && request.resource.data.interests.size() <= 20
        && request.resource.data.stats is map;
    }

    // 4) ห้องเรียน: เห็นข้อมูลกันได้เฉพาะคนที่อยู่ห้องเดียวกัน
    function signedIn() { return request.auth != null; }
    function isMember(rid) {
      return exists(/databases/$(database)/documents/rooms/$(rid)/members/$(request.auth.uid));
    }
    function okRoomName(n) { return n is string && n.size() >= 1 && n.size() <= 40; }
    function okCode(c) { return c is string && c.size() == 6; }
    function okRoom(d) {
      return d.keys().hasOnly(['name', 'owner', 'code', 'createdAt']) && okRoomName(d.name) && okCode(d.code) && shortText(d, 'createdAt', 40);
    }
    // สรุปการเรียนที่สมาชิกส่งเข้าห้อง (ไม่มีชื่อจริง อายุ อีเมล บันทึก หรือรูปแม่น้ำ)
    function okMember(d) {
      return d.keys().hasOnly(['nickname', 'photoURL', 'accent', 'code', 'joinedAt', 'updatedAt', 'daily', 'total', 'rounds',
                               'streak', 'best', 'lastDate', 'subjects', 'fishN', 'live'])
        && d.nickname is string && d.nickname.size() <= 40
        && okCode(d.code)
        && shortText(d, 'photoURL', 500) && shortText(d, 'accent', 20) && shortText(d, 'lastDate', 10)
        && shortText(d, 'joinedAt', 40) && shortText(d, 'updatedAt', 40)
        && (!('daily' in d) || (d.daily is map && d.daily.size() <= 40))
        && (!('subjects' in d) || (d.subjects is list && d.subjects.size() <= 5))
        && (!('live' in d) || (d.live is map && d.live.keys().hasOnly(['s', 'ph', 'sub', 'end', 'at'])));
    }

    match /rooms/{rid} {
      allow read: if signedIn() && (isMember(rid) || resource.data.owner == request.auth.uid);
      // สร้างห้องพร้อมรหัสเชิญในคราวเดียว (batch) — รหัสต้องชี้กลับมาที่ห้องนี้
      allow create: if signedIn() && okRoom(request.resource.data)
        && request.resource.data.owner == request.auth.uid
        && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.roomId == rid;
      allow update: if signedIn() && resource.data.owner == request.auth.uid && okRoom(request.resource.data)
        && request.resource.data.owner == resource.data.owner
        && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.roomId == rid;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /members/{mid} {
        allow read: if signedIn() && isMember(rid);
        // เข้าห้องได้เฉพาะคนที่รู้รหัสปัจจุบันของห้อง และเขียนได้แค่ข้อมูลของตัวเอง
        allow create: if signedIn() && mid == request.auth.uid && okMember(request.resource.data)
          && getAfter(/databases/$(database)/documents/rooms/$(rid)).data.code == request.resource.data.code;
        allow update: if signedIn() && mid == request.auth.uid && okMember(request.resource.data)
          && request.resource.data.code == resource.data.code;
        // ออกจากห้องเอง หรือเจ้าของห้องเอาออก
        allow delete: if signedIn() && (mid == request.auth.uid
          || get(/databases/$(database)/documents/rooms/$(rid)).data.owner == request.auth.uid);
      }
    }

    // รหัสเชิญ 6 ตัว → ห้อง: เปิดดูทีละรหัสได้ (ต้องรู้รหัส) แต่ไล่ดูรายการทั้งหมดไม่ได้
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && okCode(code)
        && request.resource.data.keys().hasOnly(['roomId', 'name', 'owner'])
        && request.resource.data.owner == request.auth.uid
        && okRoomName(request.resource.data.name)
        && getAfter(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.owner == request.auth.uid
        && getAfter(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.code == code;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }

    match /users/{uid} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['profile'])
        && okProfile(request.resource.data.profile);

      match /{col}/{docId} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid)
          && col in ['sessions', 'tasks', 'slots', 'subjects', 'settings', 'rooms']
          && okItem(request.resource.data);
      }
    }
  }
}
